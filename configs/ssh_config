#
# SSH configuration
#

#
# The following settings aim at keep ssh connections up longer
# and to avoid broken pipe errors
#
Host *
  ServerAliveInterval 30
  ServerAliveCountMax 5
  TCPKeepAlive yes
  ForwardAgent yes
  ForwardX11 yes

Host *.dren.mil
    AddressFamily inet

